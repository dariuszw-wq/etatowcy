---
import { type Lang, locales, t, href, type RouteKey, ui } from '../i18n/ui';
interface Props { lang: Lang; route?: RouteKey; slug?: string }
const { lang, route, slug } = Astro.props;
const tr = t(lang);
const base = import.meta.env.BASE_URL;
const nav: [RouteKey, string][] = [
  ['jobs', tr('nav.jobs')], ['employers', tr('nav.employers')], ['news', tr('nav.news')], ['contact', tr('nav.contact')],
];
const path = Astro.url.pathname;
---
<header class="hdr">
  <div class="wrap bar">
    <a class="logo" href={href(lang)} aria-label="Etatowcy">
      <img src={base + 'etatowcy-logo-blue.svg'} alt="Etatowcy" width="187" height="32">
    </a>
    <nav class="main" aria-label={tr('nav.menu')}>
      <ul>
        {nav.map(([r, label]) => <li><a href={href(lang, r)} aria-current={path.startsWith(href(lang, r)) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <nav class="lang" aria-label={tr('nav.lang')}>
        {locales.map((l) => <a href={href(l, route, slug)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} title={ui[l].langName}>{l.toUpperCase()}</a>)}
      </nav>
      <button class="theme" type="button" aria-label={tr('nav.theme')} data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="burger" type="button" aria-label={tr('nav.menu')} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile" hidden aria-label={tr('nav.menu')}>
    <ul class="wrap">
      {nav.map(([r, label]) => <li><a href={href(lang, r)}>{label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .hdr{position:relative;z-index:5}
  .bar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-6);padding-block:var(--space-6)}
  .logo img{height:32px;width:auto}
  .main ul{display:flex;gap:var(--space-6)}
  .main a{font:500 14px/20px var(--font-sans);color:var(--ink-muted);padding:6px 0;border-bottom:2px solid transparent;transition:color .18s ease-out}
  .main a:hover,.main a[aria-current]{color:var(--ink)}
  .main a[aria-current]{border-color:var(--brand)}
  .tools{display:flex;align-items:center;gap:var(--space-3)}
  .lang{display:flex;gap:6px}
  .lang a{font:600 12px/16px var(--font-sans);letter-spacing:.06em;padding:6px 9px;border-radius:var(--radius-sm);border:1px solid var(--line);transition:background .18s ease-out}
  .lang a:hover{background:var(--brand-glow)}
  .lang a[aria-current]{background:var(--brand);color:var(--on-brand);border-color:transparent}
  .theme,.burger{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius-sm);border:1px solid var(--line);background:transparent;cursor:pointer;color:var(--ink);transition:background .18s ease-out}
  .theme:hover,.burger:hover{background:var(--brand-glow)}
  .burger{display:none;flex-direction:column;gap:5px}
  .burger span{display:block;width:16px;height:2px;background:currentColor;border-radius:2px;transition:transform .18s ease-out}
  .burger[aria-expanded="true"] span:first-child{transform:translateY(3.5px) rotate(45deg)}
  .burger[aria-expanded="true"] span:last-child{transform:translateY(-3.5px) rotate(-45deg)}
  .mobile{border-top:1px solid var(--line);background:var(--surface)}
  .mobile ul{padding-block:var(--space-4)}
  .mobile a{display:block;padding:var(--space-3) 0;font:600 17px/24px var(--font-sans)}
  @media (max-width:900px){.main{display:none}.burger{display:inline-flex}}
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const systemLight = matchMedia('(prefers-color-scheme: light)').matches;
    const current = root.dataset.theme ?? (systemLight ? 'light' : 'dark');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('etatowcy:theme', next); } catch {}
  });
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobile = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });
</script>
