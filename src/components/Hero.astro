---
import { type Lang, t, href } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---
<section class="hero" data-hero>
  <div class="blob" aria-hidden="true" data-blob></div>
  <div class="wrap inner">
    <p class="eyebrow">{tr('hero.eyebrow')}</p>
    <h1 class="disp hero-title" data-kinetic>
      {tr('hero.title.1')}<br>{tr('hero.title.2')}<br><span class="accent">{tr('hero.title.3')}</span>
    </h1>
    <p class="lead" data-lead data-candidate={tr('hero.lead.candidate')} data-employer={tr('hero.lead.employer')}>{tr('hero.lead')}</p>
    <form class="search" action={href(lang, 'jobs')} method="get" role="search">
      <label class="sr-only" for="q">{tr('hero.searchBtn')}</label>
      <input id="q" name="q" type="search" placeholder={tr('hero.search')} autocomplete="off">
      <button class="btn primary" type="submit">{tr('hero.searchBtn')}</button>
    </form>
    <div class="entries">
      <a class="btn" href={href(lang, 'jobs')} data-role="candidate">{tr('hero.candidate')} →</a>
      <a class="btn" href={href(lang, 'employers')} data-role="employer">{tr('hero.employer')} →</a>
    </div>
  </div>
</section>

<style>
  .hero{position:relative;overflow:hidden;padding-block:var(--space-12) var(--section)}
  .inner{position:relative;z-index:1;max-width:1200px}
  .hero .eyebrow{display:block;margin-bottom:var(--space-6)}
  .hero .lead{margin:var(--space-6) 0 var(--space-8)}
  .blob{position:absolute;right:-10%;top:-20%;width:62%;height:130%;pointer-events:none;
    background:radial-gradient(closest-side at 45% 50%,var(--blob-1) 0%,var(--blob-2) 38%,transparent 72%);
    filter:blur(28px);opacity:.85;animation:drift 12s ease-in-out infinite alternate;will-change:transform;
    transform:translate(var(--mx,0),var(--my,0))}
  @keyframes drift{from{rotate:0deg;scale:1}to{rotate:12deg;scale:1.12}}
  [data-theme="light"] .blob{opacity:.55}
  @media (prefers-color-scheme:light){:root:not([data-theme]) .blob{opacity:.55}}
  .search{display:flex;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-pill);padding:6px 6px 6px 22px;max-width:520px;align-items:center;gap:12px}
  .search:focus-within{box-shadow:var(--shadow-glow)}
  .search input{flex:1;min-width:0;background:transparent;border:0;outline:0;font:400 15px/22px var(--font-sans)}
  .search input::placeholder{color:var(--ink-muted)}
  .search input::-webkit-search-cancel-button{display:none}
  .entries{display:flex;gap:var(--space-3);margin-top:var(--space-6);flex-wrap:wrap}
  @media (max-width:600px){.search{flex-direction:column;border-radius:var(--radius-lg);padding:var(--space-2)}.search input{width:100%;padding:12px 14px}.search .btn{width:100%}}
</style>

<script>
  // Sygnatura: nagłówek tężeje (300 → 800) w miarę przewijania; kształt podąża za kursorem.
  const title = document.querySelector<HTMLElement>('[data-kinetic]');
  const blob = document.querySelector<HTMLElement>('[data-blob]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (title && !reduce) {
    title.style.setProperty('--w', '300');
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = Math.min(1, Math.max(0, scrollY / 320));
      const w = Math.round(300 + y * 500);
      title.style.setProperty('--w', String(w));
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    // pierwsze tężenie po załadowaniu — zaproszenie do przewinięcia
    requestAnimationFrame(() => { title.style.transition = 'font-variation-settings 1.4s ease-out'; title.style.setProperty('--w', '520'); setTimeout(() => { title.style.transition = ''; update(); }, 1500); });
  }
  if (blob && !reduce && matchMedia('(pointer: fine)').matches) {
    addEventListener('pointermove', (e) => {
      const x = (e.clientX / innerWidth - .5) * -40, y = (e.clientY / innerHeight - .5) * -30;
      blob.style.setProperty('--mx', x + 'px'); blob.style.setProperty('--my', y + 'px');
    }, { passive: true });
  }
  // Personalizacja: zapamiętana rola zmienia wstęp przy kolejnej wizycie.
  const lead = document.querySelector<HTMLElement>('[data-lead]');
  try {
    const role = localStorage.getItem('etatowcy:role');
    if (lead && role && lead.dataset[role]) lead.textContent = lead.dataset[role]!;
    document.querySelectorAll<HTMLAnchorElement>('[data-role]').forEach((a) =>
      a.addEventListener('click', () => localStorage.setItem('etatowcy:role', a.dataset.role!)));
  } catch {}
</script>
