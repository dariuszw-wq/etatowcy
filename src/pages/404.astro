---
// Strona błędu dla całej domeny — GitHub Pages podaje ją pod każdym nieistniejącym adresem.
// Jedna dla trzech języków, bo w momencie błędu nie wiadomo, którego szukał odwiedzający.
import '../styles/global.css';
import { locales, routes, t, href, type Lang } from '../i18n/ui';

const base = import.meta.env.BASE_URL;
const copy: Record<Lang, { title: string; lead: string; back: string }> = {
  pl: { title: 'Nie ma takiej strony', lead: 'Adres jest błędny albo strona została przeniesiona. Poniżej najczęściej szukane miejsca.', back: 'Strona główna' },
  en: { title: 'Page not found', lead: 'The address is wrong or the page has moved. Below are the places people look for most often.', back: 'Home page' },
  es: { title: 'Página no encontrada', lead: 'La dirección es incorrecta o la página se ha movido. Abajo están las secciones más buscadas.', back: 'Página principal' },
};
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nie ma takiej strony · Page not found · Página no encontrada — Etatowcy</title>
<meta name="robots" content="noindex">
<link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml">
<style set:html={`
@font-face{font-family:"Big Shoulders Display";src:url("${base}fonts/BigShouldersDisplay-wght.woff2") format("woff2");font-weight:100 900;font-display:swap}
@font-face{font-family:"Inter";src:url("${base}fonts/Inter-opsz-wght.woff2") format("woff2");font-weight:100 900;font-display:swap}
`}></style>
<script is:inline>
  try { var th = localStorage.getItem('etatowcy:theme'); if (th) document.documentElement.dataset.theme = th; } catch (e) {}
</script>
</head>
<body>
<main id="main">
  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">404</span>
      {locales.map((lang) => (
        <div class="block">
          <h2 class="disp h2">{copy[lang].title}</h2>
          <p class="lead">{copy[lang].lead}</p>
          <p class="links">
            <a class="btn primary" href={href(lang)}>{copy[lang].back}</a>
            <a class="link" href={href(lang, 'jobs')}>{t(lang)('nav.jobs')}</a>
            <a class="link" href={href(lang, 'employers')}>{t(lang)('nav.employers')}</a>
            <a class="link" href={href(lang, 'news')}>{t(lang)('nav.news')}</a>
            <a class="link" href={href(lang, 'contact')}>{t(lang)('nav.contact')}</a>
          </p>
        </div>
      ))}
    </div>
  </section>
</main>
<style>
  .narrow{max-width:820px}
  .block{padding:var(--space-8) 0;border-top:1px solid var(--line)}
  .block:first-of-type{border-top:0}
  .h2{margin:var(--space-2) 0 var(--space-3)}
  .lead{color:var(--ink-muted);max-width:56ch}
  .links{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-4);margin-top:var(--space-5)}
</style>
</body>
</html>
