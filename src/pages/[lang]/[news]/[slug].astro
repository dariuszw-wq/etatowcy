---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { locales, routes, type Lang, t, href } from '../../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('news');
  return all.map((item) => {
    const lang = item.data.lang as Lang;
    const slug = item.id.split('/').pop()!;
    const translated = locales.every((l) => all.some((n) => n.data.lang === l && n.id.endsWith('/' + slug)));
    return { params: { lang, news: routes.news[lang], slug }, props: { item, translated } };
  });
}
const { item, translated } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const tr = t(lang);
const d = item.data;
const { Content } = await render(item);
const date = d.published.toLocaleDateString(lang === 'pl' ? 'pl-PL' : lang, { day: '2-digit', month: 'long', year: 'numeric' });
const site = Astro.site?.origin ?? '';
const article = {
  '@context': 'https://schema.org', '@type': 'NewsArticle',
  headline: d.title, description: d.excerpt, datePublished: d.published.toISOString(), inLanguage: lang,
  author: { '@type': 'Organization', name: 'Etatowcy' }, publisher: { '@type': 'Organization', name: 'Etatowcy' },
  mainEntityOfPage: site + href(lang, 'news', slug),
};
---
<Base lang={lang} route="news" slug={slug} translated={translated} title={`${d.title} — Etatowcy`} description={d.excerpt} jsonLd={[article]}>
  <article class="section">
    <div class="wrap narrow">
      <a class="link" href={href(lang, 'news')}>{tr('news.back')}</a>
      <p class="small meta">{date} · {d.readingTime} {tr('news.min')}</p>
      <h1 class="disp h1">{d.title}</h1>
      <p class="lead">{d.excerpt}</p>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>
<style>
  .narrow{max-width:820px}
  .meta{margin:var(--space-6) 0 var(--space-2)}
  .h1{font-size:clamp(40px,6vw,80px);text-transform:none;margin-bottom:var(--space-6)}
  .lead{margin-bottom:var(--space-8);max-width:60ch}
</style>
