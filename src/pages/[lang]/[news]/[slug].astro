---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { locales, routes, type Lang, t, href } from '../../../i18n/ui';
import { breadcrumb } from '../../../seo';

export async function getStaticPaths() {
  const all = await getCollection('news');
  return all.map((item) => {
    const lang = item.data.lang as Lang;
    const slug = item.id.split('/').pop()!;
    const translated = locales.every((l) => all.some((n) => n.data.lang === l && n.id.endsWith('/' + slug)));
    // Bez przelinkowania robot dociera do artykułu wyłącznie przez listę — każdy tekst
    // dostaje więc trzy sąsiednie z tego samego języka (najnowsze, pomijając samego siebie).
    const related = all
      .filter((n) => n.data.lang === lang && n.id !== item.id)
      .sort((a, b) => +b.data.published - +a.data.published)
      .slice(0, 3)
      .map((n) => ({ slug: n.id.split('/').pop()!, title: n.data.title, excerpt: n.data.excerpt }));
    return { params: { lang, news: routes.news[lang], slug }, props: { item, translated, related } };
  });
}
const { item, translated, related } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const tr = t(lang);
const d = item.data;
const { Content } = await render(item);
const date = d.published.toLocaleDateString(lang === 'pl' ? 'pl-PL' : lang, { day: '2-digit', month: 'long', year: 'numeric' });
const site = Astro.site?.origin ?? '';
const article = {
  '@context': 'https://schema.org', '@type': 'NewsArticle',
  headline: d.title, description: d.excerpt, datePublished: d.published.toISOString(), inLanguage: lang,
  author: { '@type': 'Organization', name: 'Etatowcy' }, publisher: { '@type': 'Organization', name: 'Etatowcy' },
  image: site + import.meta.env.BASE_URL + 'og.png',
  mainEntityOfPage: site + href(lang, 'news', slug),
};
const crumbs = breadcrumb(site, lang, 'news', 'nav.news', d.title, slug);
---
<Base lang={lang} route="news" slug={slug} translated={translated} title={`${d.seoTitle ?? d.title} — Etatowcy`} description={d.excerpt} jsonLd={[article, crumbs]}>
  <article class="section">
    <div class="wrap narrow">
      <a class="link" href={href(lang, 'news')}>{tr('news.back')}</a>
      <p class="small meta">{date} · {d.readingTime} {tr('news.min')}</p>
      <h1 class="disp h1">{d.title}</h1>
      <p class="lead">{d.excerpt}</p>
      <div class="prose"><Content /></div>

      {related.length > 0 && (
        <aside class="more">
          <h2 class="eyebrow">{tr('news.more')}</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={href(lang, 'news', r.slug)}>
                  <span class="t">{r.title}</span>
                  <span class="small">{r.excerpt}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link all" href={href(lang, 'news')}>{tr('news.all')} →</a>
        </aside>
      )}
    </div>
  </article>
</Base>
<style>
  .narrow{max-width:820px}
  .meta{margin:var(--space-6) 0 var(--space-2)}
  .h1{font-size:clamp(40px,6vw,80px);text-transform:none;margin-bottom:var(--space-6)}
  .lead{margin-bottom:var(--space-8);max-width:60ch}
  .more{margin-top:var(--space-16);padding-top:var(--space-8);border-top:1px solid var(--line)}
  .more .eyebrow{display:block;margin-bottom:var(--space-4)}
  .more ul{display:grid;gap:var(--space-3)}
  .more a{display:grid;gap:4px;padding:var(--space-4);background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-md);transition:transform .18s ease-out,box-shadow .18s ease-out}
  .more a:hover{transform:translateY(-2px);box-shadow:var(--shadow-card)}
  .more .t{font:600 17px/24px var(--font-sans)}
  .more .small{color:var(--ink-muted)}
  .more .all{display:inline-block;margin-top:var(--space-4);padding:0;background:none;border:0}
  .more .all:hover{transform:none;box-shadow:none}
</style>
