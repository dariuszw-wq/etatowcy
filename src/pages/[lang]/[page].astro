---
// Strony statyczne: pracodawcy · kontakt · polityka prywatności — jeden plik, trasa wg języka.
import Base from '../../layouts/Base.astro';
import ContactWizard from '../../components/ContactWizard.astro';
import { locales, routes, type Lang, type RouteKey, t, href } from '../../i18n/ui';
import { site } from '../../config';

export function getStaticPaths() {
  const pages: RouteKey[] = ['employers', 'contact', 'privacy'];
  return locales.flatMap((lang) => pages.map((page) => ({ params: { lang, page: routes[page][lang] }, props: { page } })));
}
const { page } = Astro.props as { page: RouteKey };
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const titles: Record<string, string> = { employers: tr('nav.employers'), contact: tr('nav.contact'), privacy: tr('privacy.title') };
const privacy = {
  pl: [
    `Administratorem danych osobowych podanych w formularzu kontaktowym jest ${site.legalName}. Kontakt: ${site.email}.`,
    'Dane (imię i nazwisko, e-mail lub telefon, treść wiadomości) przetwarzamy wyłącznie po to, żeby odpowiedzieć na wiadomość i — jeśli o to prosisz — przedstawić ofertę pracy lub współpracy. Podstawa: Twoja zgoda oraz nasz uzasadniony interes (art. 6 ust. 1 lit. a i f RODO).',
    'Dane przechowujemy do zakończenia sprawy, nie dłużej niż 12 miesięcy, chyba że rozpoczniemy proces rekrutacji — wtedy do jego zakończenia.',
    'Masz prawo dostępu do danych, ich sprostowania, usunięcia, ograniczenia przetwarzania, wniesienia sprzeciwu oraz skargi do Prezesa Urzędu Ochrony Danych Osobowych.',
    'Strona nie używa ciasteczek śledzących ani analityki zewnętrznej. W przeglądarce zapisujemy tylko Twój wybór języka i motywu.',
  ],
  en: [
    `The controller of personal data submitted through the contact form is ${site.legalName}. Contact: ${site.email}.`,
    'We process the data (name, e-mail or phone, message) solely to reply to your message and, if you ask, to present a job or cooperation offer. Legal basis: your consent and our legitimate interest (Art. 6(1)(a) and (f) GDPR).',
    'We keep the data until the matter is closed, no longer than 12 months, unless a recruitment process starts — then until it ends.',
    'You have the right to access, rectify and erase your data, restrict processing, object, and lodge a complaint with the Polish supervisory authority (UODO).',
    'This site uses no tracking cookies or third-party analytics. Your browser stores only your language and theme choice.',
  ],
  es: [
    `El responsable de los datos personales enviados a través del formulario de contacto es ${site.legalName}. Contacto: ${site.email}.`,
    'Tratamos los datos (nombre, e-mail o teléfono, mensaje) únicamente para responder a tu mensaje y, si lo pides, presentarte una oferta de empleo o de colaboración. Base legal: tu consentimiento y nuestro interés legítimo (art. 6.1 a y f RGPD).',
    'Conservamos los datos hasta cerrar el asunto, como máximo 12 meses, salvo que empiece un proceso de selección — entonces hasta que termine.',
    'Tienes derecho de acceso, rectificación, supresión, limitación, oposición y a presentar una reclamación ante la autoridad polaca de protección de datos (UODO).',
    'Este sitio no usa cookies de seguimiento ni analítica de terceros. El navegador solo guarda tu idioma y tema.',
  ],
}[lang];
---
<Base lang={lang} route={page} title={`${titles[page]} — Etatowcy`} description={page === 'employers' ? tr('emp.lead') : page === 'contact' ? tr('contact.lead') : undefined}>
  {page === 'employers' && (
    <section class="section">
      <div class="wrap split">
        <header>
          <span class="eyebrow">{tr('emp.eyebrow')}</span>
          <h1 class="disp h1">{tr('emp.title.1')}<br>{tr('emp.title.2')}</h1>
          <p class="lead">{tr('emp.lead')}</p>
          <a class="btn primary" href="#zlec">{tr('emp.cta')}</a>
        </header>
        <div>
          <ul class="services">
            {(['s1', 's2', 's3', 's4'] as const).map((s) => (
              <li><h2 class="h3">{tr(`emp.${s}.t`)}</h2><p>{tr(`emp.${s}.d`)}</p></li>
            ))}
          </ul>
          <section id="zlec" class="apply">
            <span class="eyebrow">{tr('emp.cta')}</span>
            <h2 class="disp h2">{tr('contact.title.1')} {tr('contact.title.2')}</h2>
            <ContactWizard lang={lang} only="employer" subject={tr('emp.cta')} />
          </section>
        </div>
      </div>
    </section>
  )}
  {page === 'contact' && (
    <section class="section">
      <div class="wrap split">
        <header>
          <span class="eyebrow">{tr('contact.eyebrow')}</span>
          <h1 class="disp h1">{tr('contact.title.1')}<br>{tr('contact.title.2')}</h1>
          <p class="lead">{tr('contact.lead')}</p>
          <p class="data"><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
          {site.phone && <p class="data"><a class="link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>}
        </header>
        <ContactWizard lang={lang} />
      </div>
    </section>
  )}
  {page === 'privacy' && (
    <section class="section">
      <div class="wrap narrow">
        <h1 class="disp h1">{tr('privacy.title')}</h1>
        <div class="prose">{privacy.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .h1{margin:var(--space-2) 0 var(--space-6)}
  .narrow{max-width:820px}
  .services{display:grid;gap:var(--space-4)}
  .services li{padding:var(--space-6);background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-lg)}
  .services .h3{color:var(--brand)}
  .services p{color:var(--ink-muted);margin-top:var(--space-2);max-width:52ch}
  .apply{margin-top:var(--space-16);padding-top:var(--space-12);border-top:1px solid var(--line)}
  .apply .h2{margin:var(--space-2) 0 var(--space-8)}
  header .data{margin-top:var(--space-2)}
</style>
