---
// Strona główna bez języka: wybiera język przeglądarki (pl/en/es), domyślnie polski.
const base = import.meta.env.BASE_URL;
// hreflang wymaga adresów bezwzględnych — względne Google ignoruje.
const abs = (path: string) => (Astro.site?.origin ?? '') + base + path;
// Komunikatory pobierają podgląd z adresu, który dostały — a „etatowcy.pl" bez języka trafia tutaj.
const title = 'Etatowcy — agencja pracy. Praca, która się opłaca.';
const description = 'Agencja pracy Etatowcy: oferty pracy w całej Polsce, legalne zatrudnianie cudzoziemców, wiadomości z rynku pracy. Po polsku, angielsku i hiszpańsku.';
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<title>Etatowcy</title>
<meta name="robots" content="noindex">
<meta name="google-site-verification" content="VF3RE7dSyHKm47EivNGskAWejGo81_v2Av1ideR_UfI">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content={description}>
<link rel="alternate" hreflang="pl" href={abs('pl/')}>
<link rel="alternate" hreflang="en" href={abs('en/')}>
<link rel="alternate" hreflang="es" href={abs('es/')}>
<link rel="alternate" hreflang="x-default" href={abs('pl/')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Etatowcy">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={abs('pl/')}>
<meta property="og:locale" content="pl_PL">
<meta property="og:image" content={abs('og.png')}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml">
<meta http-equiv="refresh" content={`0;url=${base}pl/`}>
<script is:inline set:html={`
(function(){var b=${JSON.stringify(base)};var s=null;try{s=localStorage.getItem('etatowcy:lang')}catch(e){}
var l=s||((navigator.language||'pl').slice(0,2).toLowerCase());if(l!=='en'&&l!=='es')l='pl';location.replace(b+l+'/');})();
`}></script>
</head>
<body><a href={base + 'pl/'}>Polski</a> · <a href={base + 'en/'}>English</a> · <a href={base + 'es/'}>Español</a></body>
</html>
